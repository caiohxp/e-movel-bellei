  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Bellei acredita que o esporte vai al\xE9m da competi\xE7\xE3o: \xE9
    movimento, tradi\xE7\xE3o e legado.\r\n\r\nPor isso, apoia modalidades que refletem
    sua ess\xEAncia \u2014 como o hipismo, o iatismo e o t\xEAnis \u2014 esportes
    que unem eleg\xE2ncia, hist\xF3ria e disciplina, inspirando gera\xE7\xF5es pela
    forma como atravessam o tempo com gra\xE7a e prop\xF3sito.\r\n\r\nAo incentivar
    essas pr\xE1ticas, a marca reafirma seu compromisso com a excel\xEAncia, a dedica\xE7\xE3o
    e a inova\xE7\xE3o\r\n\u2014 valores que moldam cada empreendimento, detalhe
    e experi\xEAncia que leva sua assinatura.\r\n\r\nPorque apoiar o esporte \xE9,
    acima de tudo, celebrar o que \xE9 atemporal.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4f71f3572cb22294dad456dec3e4cc6c, type: 2}
