  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Existem lugares que t\xEAm o poder de parar o tempo \u2014 e o  Timeless
    \xE9 um deles. Com arquitetura assinada por um dos nomes mais renomados da atualidade,
    o empreendimento est\xE1 situado na regi\xE3o mais nobre da cidade, em uma das
    esquinas mais valorizadas.\nSua infraestrutura re\xFAne sofistica\xE7\xE3o, lazer
    e conveni\xEAncia, com uma vista deslumbrante do alto da cidade e ambientes projetados
    para acolher cada momento com eleg\xE2ncia."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4f71f3572cb22294dad456dec3e4cc6c, type: 2}
