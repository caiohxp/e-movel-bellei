  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A AO \xE9 uma ag\xEAncia de arquitetura, urbanismo e interior design liderada
    por Greg Bousquet, com sede no Brasil e presen\xE7a em Portugal, Espanha e It\xE1lia.
    Reconhecida internacionalmente por unir o global ao local e o t\xE9cnico ao art\xEDstico,
    cria solu\xE7\xF5es inovadoras que integram o urbano ao natural.\n\nCom projetos
    em mais de 15 estados brasileiros e obras exclusivas no Peru, Chile e Portugal,
    a AO transforma espa\xE7os e valoriza a experi\xEAncia humana no ambiente urbano,
    reafirmando seu compromisso com uma arquitetura que inspira, conecta e transcende
    fronteiras."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4f71f3572cb22294dad456dec3e4cc6c, type: 2}
