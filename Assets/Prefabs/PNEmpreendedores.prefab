  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Cy Capital \xE9 uma gestora de recursos independente.\r\n Ela faz parte
    do Grupo Cyrela, que possui d\xE9cadas de \r\nexperi\xEAncia e atua\xE7\xE3o
    no mercado imobili\xE1rio.\r\n\n A Cy Capital refor\xE7a a atua\xE7\xE3o da Cyrela
    em segmentos \r\ndiversificados do mercado imobili\xE1rio, atuando apenas \r\nem
    mercados que conhecem profundamente. \r\n\nDessa forma, possuem fundos de investime
    Cy.log \r\nGuarulhos F2Cy.log Guarulhos F1Cy.log Embu nto \r\nimobili\xE1rio
    nos segmentos de galp\xF5es log\xEDsticos \r\ne opera\xE7\xF5es estruturadas
    de cr\xE9dito/equity em \r\nincorpora\xE7\xF5es imobili\xE1rias, somando mais
    de\r\n R$ 2,8 bilh\xF5es sob gest\xE3o."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 171abef425084a54da8c5e9ba9a0ab61, type: 2}
  m_sharedMaterial: {fileID: 7172796790267024058, guid: 171abef425084a54da8c5e9ba9a0ab61,
